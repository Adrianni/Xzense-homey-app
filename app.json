          "type": "number",
          "label": {
            "en": "Poll interval while burning",
            "no": "Oppdateringsintervall under fyring"
          },
          "hint": {
            "en": "How often the controller is read while the fireplace is running (boost, operation, burnout, afterrun). Changes made from Homey are still sent immediately. Shorter keeps values more live but uses more controller battery.",
            "no": "Hvor ofte kontrolleren leses mens peisen er i gang (boost, drift, utbrenning, etterkjøring). Endringer fra Homey sendes fortsatt umiddelbart. Kortere gir mer live verdier, men bruker mer batteri i kontrolleren."
          },
          "value": 30,
          "min": 30,
          "max": 600,
          "units": {
            "en": "s"
          }
        },
        {
          "id": "keep_alive",
          "type": "number",
          "label": {
            "en": "Keep connection open after a change",
            "no": "Hold forbindelsen åpen etter en endring"
          },
          "hint": {
            "en": "After a change from Homey the Bluetooth connection stays open this long, so further changes (for example dragging the slider again) take effect instantly. 0 disconnects right away. While it is open, other apps cannot connect to the controller.",
            "no": "Etter en endring fra Homey holdes Bluetooth-forbindelsen åpen så lenge, slik at flere endringer (for eksempel å dra i slideren igjen) virker umiddelbart. 0 kobler fra med en gang. Mens den er åpen kan ikke andre apper koble til kontrolleren."
          },
          "value": 20,
          "min": 0,
          "max": 120,
          "units": {
            "en": "s"
          }
        },
        {
          "id": "fan_step",
          "type": "number",
          "label": {
            "en": "Fan slider step",
            "no": "Steg på viftehastighet-slider"
          },
          "hint": {
            "en": "How many percent the slider moves per step.",
            "no": "Hvor mange prosent slideren flytter seg per steg."
